{
  "name": "kern",
  "version": "0.2.0",
  "private": true,
  "description": "KERN Developer Command Center",
  "author": "bxane-dev",
  "homepage": "https://github.com/bxane-dev/kern",
  "repository": {
    "type": "git",
    "url": "https://github.com/bxane-dev/kern.git"
  },
  "main": "electron/main.cjs",
  "desktopName": "dev.bxane.kern.desktop",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:desktop": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:dev",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:dist": "npm run build:desktop && electron-builder --publish never",
    "desktop:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "desktop:linux": "npm run build:desktop && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "dev.bxane.kern",
    "productName": "KERN",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KERN",
      "artifactName": "KERN-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.svg",
      "category": "Development",
      "maintainer": "bxane-dev <noreply@github.com>",
      "executableName": "kern",
      "syncDesktopName": true,
      "synopsis": "Developer command center",
      "description": "GitHub activity, deployments, logs, uptime, issues and TODOs in one desktop command center.",
      "desktop": {
        "entry": {
          "Name": "KERN",
          "Comment": "Developer Command Center",
          "Categories": "Development;",
          "Keywords": "developer;github;deployments;logs;uptime;",
          "Terminal": false,
          "Type": "Application"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KERN-${version}-${arch}.${ext}"
    }
  }
}
