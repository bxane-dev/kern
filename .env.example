# KERN access protection. Set this in production.
KERN_PASSWORD=

# GitHub
GITHUB_OWNER=bxane-dev
GITHUB_TOKEN=

# Vercel (optional)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Render (optional)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Uptime monitors: Name|URL;Name|URL
KERN_MONITORS=XAN|https://example.com;API|https://api.example.com/health
# Raise a warning when an operational monitor exceeds this latency.
KERN_LATENCY_WARN_MS=1500

# Supabase persistence (optional but recommended)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
